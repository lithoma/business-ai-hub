# Configuration template only. Inject real secrets through the company secret store.
# The application DOES NOT automatically load this file.
HUB_AUTH_MODE=oauth
HUB_PUBLIC_ORIGIN=https://business-ai.company.example
DATABRICKS_HOST=https://your-company-workspace.cloud.databricks.com
# Company admin registers an OAuth app with this exact callback:
# https://business-ai.company.example/auth/callback
HUB_OAUTH_CLIENT_ID=
# Confidential web clients additionally inject HUB_OAUTH_CLIENT_SECRET (never Git).
HUB_OAUTH_SCOPES=iam.current-user:read ai-gateway sql:restricted-query model-serving offline_access
# Separate SDK profile for metadata only. No business-table SELECT grants.
HUB_STORAGE_PROFILE=business-ai-hub-storage
SQL_WAREHOUSE_ID=
TASK_REGISTRY_TABLE=your_catalog.your_schema.business_task_registry_v1
TASK_RUNS_TABLE=your_catalog.your_schema.business_task_runs_v1

# A single Genie One connection derived from DATABRICKS_HOST and current-user OAuth.
# No A1/A2 IDs or separate MCP API key.
GENIE_ONE_ENABLED=false
HUB_WORKFLOW_ENABLED=true
TASK_CONDITION_SQL_ENABLED=false
TASK_PARSER_ENDPOINT=system.ai.gpt-oss-20b
CONVERSATION_ROUTER_ENDPOINT=

# Activation never starts a Job. Keep disabled pending integration acceptance and
# a company-approved durable task-creator credential broker / CreatorRunner.
TASK_EXECUTION_ENABLED=false
TASK_DISPATCH_TIME=09:00
TASK_DISPATCH_TIMEZONE=Asia/Shanghai
TASK_EMAIL_ENABLED=false
# Optional paths: HUB_TASK_MANAGER_ROOT (default: sibling Task Manager in this Git)
# Optional local telemetry: HUB_TEST_METRICS_DB (private writable path, outside Git).
# Inject stable TASK_SQL_REVIEW_SECRET via the secret store for production receipts.
# Gmail remains a separate sender OAuth setup, never a Databricks/MCP credential.
# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN are secret-store values.
