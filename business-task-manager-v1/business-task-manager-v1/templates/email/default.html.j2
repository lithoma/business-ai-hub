<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><title>{{ task_name }}</title></head>
<body style="font-family:Arial,sans-serif;color:#25334a;line-height:1.7">
  <h1>{{ task_name }}</h1>
  <p>执行日期：{{ dispatch_date }} · 业务日期：{{ business_date }}</p>
  {% if trigger_reason %}<p>触发依据：{{ trigger_reason }}</p>{% endif %}
  <div>{{ report_html }}</div>
  {% if attachments %}<h2>数据附件</h2><ul>{% for file in attachments %}
    <li>{{ file.filename }}：{{ file.rows }} 行、{{ file.columns }} 列</li>
  {% endfor %}</ul>{% endif %}
  <p style="font-size:12px;color:#67758a">Business AI Hub · {{ run_id }}</p>
</body></html>
